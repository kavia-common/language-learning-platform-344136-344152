# Frontend configuration (Next.js)
# Provide these in the real .env (handled by orchestrator/deployment)

# Base URL for the FastAPI backend (REST)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Base URL for the FastAPI backend WebSocket endpoint
# Example: ws://localhost:3001/ws
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:3001
